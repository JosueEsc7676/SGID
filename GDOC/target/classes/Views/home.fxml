<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="rootStack" styleClass="root-background" stylesheets="@../styles/home-styles.css"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gidoc.gdoc.Usuarios.web.controllers.HomeController">

    <AnchorPane>

        <!-- ===================== -->
        <!-- LAYOUT PRINCIPAL -->
        <!-- ===================== -->
        <BorderPane fx:id="mainLayout"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <top>
                <VBox styleClass="header-home">
                    <HBox spacing="20" styleClass="header-content">

                        <!-- Botón hamburguesa -->
                        <Button fx:id="menuButton"
                                alignment="CENTER_RIGHT"
                                contentDisplay="GRAPHIC_ONLY"
                                onAction="#toggleMenu"
                                prefWidth="50"
                                style="-fx-background-color: transparent;"
                                styleClass="menu-hamburguesa">
                            <graphic>
                                <VBox alignment="CENTER_RIGHT" spacing="3">
                                    <Rectangle width="20" height="2" styleClass="menu-line"/>
                                    <Rectangle width="20" height="2" styleClass="menu-line"/>
                                    <Rectangle width="20" height="2" styleClass="menu-line"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <!-- Logo -->
                        <ImageView fitHeight="45" fitWidth="140" styleClass="logo-small"/>

                        <!-- Títulos -->
                        <VBox spacing="2">
                            <Label text="SISTEMA DE GESTIÓN DE INCAPACIDAD DE DOCENTES" styleClass="title-main-home"/>
                            <Label text="Gestión Documental de Docentes" styleClass="title-sub-home"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Info usuario -->
                        <VBox alignment="CENTER_RIGHT" spacing="5">
                            <Label fx:id="welcomeLabel" styleClass="welcome-text"/>
                            <Label fx:id="userInfoLabel" styleClass="user-info"/>
                            <Button fx:id="logoutButton" text="Cerrar Sesión" styleClass="btn-logout" onAction="#logout"/>
                        </VBox>
                    </HBox>
                    <Separator/>
                </VBox>
            </top>

            <center>
                <StackPane fx:id="mainContent" styleClass="main-content">
                    <VBox alignment="CENTER" spacing="25">
                        <Label text="¡Bienvenido al Sistema GIDOC!" styleClass="welcome-title"/>
                    </VBox>
                </StackPane>
            </center>
        </BorderPane>

        <!-- ===================== -->
        <!-- MENÚ LATERAL CON SCROLL -->
        <!-- ===================== -->
        <AnchorPane fx:id="menuPanel"
                    prefWidth="300"
                    maxWidth="300"
                    minWidth="300"
                    visible="false"
                    managed="false"
                    style="-fx-background-color: #1E2233; -fx-border-color: #2A2F40; -fx-border-width: 0 2 0 0;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 2, 0);"
                    AnchorPane.topAnchor="90"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0">

            <ScrollPane fx:id="menuScroll"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        AnchorPane.topAnchor="0"
                        AnchorPane.bottomAnchor="0"
                        AnchorPane.leftAnchor="0"
                        AnchorPane.rightAnchor="0"
                        styleClass="menu-scroll">

                <!-- VBox principal que contiene todo -->
                <VBox spacing="0" alignment="TOP_CENTER" style="-fx-padding: 15;">

                    <!-- Contenido del menú -->
                    <VBox spacing="15" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">

                        <Label text="Menú Principal GDOC" styleClass="menu-title"/>
                        <Label fx:id="menuUserInfo" styleClass="menu-user-info"/>

                        <!-- REGISTROS -->
                        <TitledPane text="REGISTROS PRINCIPALES/ESPECIALES" expanded="false" styleClass="centered-titled-pane">
                            <VBox alignment="CENTER" spacing="6">
                                <Button fx:id="btnRegistroDocente" text="Registro Docente" onAction="#abrirRegistroDocente"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                                <Button text="MATERNIDAD Y PATERNIDAD" onAction="#abrirDashboard"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                                <Button text="DUELOS" onAction="#abrirAccesosRapidos"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                                <Button text="TERAPIAS Y OTROS" onAction="#abrirAccesosRapidos"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                                <Button text="SIN GOCE DE SUELDO" onAction="#abrirAccesosRapidos"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                            </VBox>
                        </TitledPane>

                        <!-- FILTROS -->
                        <TitledPane text="FILTROS DE BÚSQUEDA" expanded="false" styleClass="centered-titled-pane">
                            <VBox fx:id="adminSecuritySection" alignment="CENTER" spacing="6">
                                <Button text="Buscar por NIP" onAction="#abrirBuscarNIP"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                                <Button text="Buscar por Código INFRA" onAction="#abrirBuscarINFRA"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                                <Button text="HISTORIAL MENSUAL" onAction="#abrirHistorialMensual"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                            </VBox>
                        </TitledPane>

                        <!-- BASE DE DATOS -->
                        <TitledPane text="BASE DE DATOS" expanded="false" styleClass="centered-titled-pane">
                            <VBox alignment="CENTER" spacing="6">
                                <Button text="Importar Docentes (Excel / DBF)" onAction="#abrirImportarBD"
                                        styleClass="menu-item-centered" maxWidth="Infinity" wrapText="true"/>
                            </VBox>
                        </TitledPane>

                        <!-- CONFIGURACIÓN -->
                        <TitledPane text="CONFIGURACIÓN DE LA CUENTA" expanded="false" styleClass="centered-titled-pane">
                            <VBox alignment="CENTER" spacing="6"/>
                        </TitledPane>

                    </VBox>

                    <!-- Footer siempre abajo -->
                    <Label text="© 2025 GDOC - Todos los derechos reservados." styleClass="menu-footer"/>
                </VBox>
            </ScrollPane>
        </AnchorPane>

    </AnchorPane>

</StackPane>
